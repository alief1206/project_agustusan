{
  "name": "web-polling",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm run dev:server",
    "dev:server": "nodemon server/src/server.js",
    "dev:client": "npm run dev --prefix client",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "start": "node server/src/server.js",
    "vercel-build": "prisma generate",
    "postinstall": "prisma generate",
    "db:create": "node server/src/scripts/createDatabase.js",
    "db:verify": "node server/src/scripts/verifyDatabase.js",
    "db:setup": "npm run db:create && npm run db:schema && npm run seed",
    "db:schema": "node server/src/scripts/pushMysqlSchema.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "node server/src/scripts/pushMysqlSchema.js",
    "prisma:migrate": "prisma migrate dev",
    "seed": "node server/src/scripts/seed.js",
    "test": "echo \"No automated tests configured yet\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.5.3",
    "multer": "^2.2.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0"
  }
}